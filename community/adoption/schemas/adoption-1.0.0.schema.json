{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "data_kind": {
      "enum": [
        "SYNTHETIC",
        "PUBLIC_AGGREGATE"
      ]
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^[a-z][a-z0-9-]{2,63}$"
          },
          "claim_kind": {
            "enum": [
              "usage",
              "independent-adoption",
              "independent-reproduction",
              "citation"
            ]
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "reference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^https://[A-Za-z0-9.-]+/[A-Za-z0-9/_.-]+$"
              },
              "sha256": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "reference",
              "sha256"
            ]
          },
          "independence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "classification": {
                "enum": [
                  "maintainer",
                  "external",
                  "unknown"
                ]
              },
              "relationship": {
                "enum": [
                  "independent",
                  "affiliated",
                  "unknown"
                ]
              },
              "review_method": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "\\S"
              }
            },
            "required": [
              "classification",
              "relationship",
              "review_method"
            ]
          },
          "execution": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "enum": [
                  "executed",
                  "not-executed"
                ]
              },
              "reference": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500,
                    "pattern": "^https://[A-Za-z0-9.-]+/[A-Za-z0-9/_.-]+$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "environment": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "\\S"
              },
              "source_commit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^[a-f0-9]{40}$"
              }
            },
            "required": [
              "status",
              "reference",
              "environment",
              "source_commit"
            ]
          },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "enum": [
                  "draft",
                  "verified"
                ]
              },
              "method": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "\\S"
              },
              "review_reference": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500,
                    "pattern": "^https://[A-Za-z0-9.-]+/[A-Za-z0-9/_.-]+$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "status",
              "method",
              "review_reference"
            ]
          },
          "citations": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "doi",
                    "public-reference"
                  ]
                },
                "reference": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "pattern": "^https://[A-Za-z0-9.-]+/[A-Za-z0-9/_.-]+$"
                }
              },
              "required": [
                "kind",
                "reference"
              ]
            }
          },
          "record_state": {
            "enum": [
              "current",
              "superseded",
              "withdrawn"
            ]
          },
          "correction": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "previous_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500,
                    "pattern": "^[a-z][a-z0-9-]{2,63}$"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500,
                    "pattern": "\\S"
                  }
                },
                "required": [
                  "previous_id",
                  "reason"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "limitations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "\\S"
            }
          }
        },
        "required": [
          "id",
          "claim_kind",
          "source",
          "independence",
          "execution",
          "verification",
          "citations",
          "record_state",
          "correction",
          "limitations"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "data_kind",
    "records"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aeglysai.com/schemas/independent-adoption/1.0.0",
  "title": "AeglysAI independent adoption evidence 1.0.0"
}
